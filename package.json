{
  "name": "@archally/realm-schema",
  "version": "2.2.2",
  "description": "YAML-based schema for private real estate modeling \u2014 dual-layer spatial topology, infrastructure systems, nature, maintenance operations, and surrounding context",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Adam Walkowski <adam.walkowski@inperceptic.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/archally/realm-schema"
  },
  "homepage": "https://archally.pro",
  "keywords": [
    "realm",
    "real-estate",
    "property",
    "estate",
    "schema",
    "yaml",
    "json-schema",
    "spatial",
    "facility-management",
    "gdsm"
  ],
  "type": "module",
  "exports": {
    "./schema/v2.2/*": "./schema/v2.2/*"
  },
  "files": [
    "schema/",
    "tools/",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-FSL",
    "NOTICE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "validate": "node tools/validator/src/cli.mjs",
    "validate:examples": "node tools/validator/src/cli.mjs --model examples/willow-cottage/.realm/v2.2 --schemas schema/v2.2",
    "doc-snippets": "node tools/doc-snippet-validate/cli.mjs docs/file-conventions.md docs/modeling-guide.md --schemas schema/v2.2 --validator \"node tools/validator/src/cli.mjs --model {model} --schemas {schemas}\"",
    "check": "node tools/semantic-checker/cli.mjs",
    "check:examples": "node tools/semantic-checker/cli.mjs --model examples/willow-cottage/.realm/v2.2"
  },
  "bin": {
    "realm-validate": "tools/validator/src/cli.mjs",
    "realm-check": "tools/semantic-checker/cli.mjs"
  },
  "dependencies": {
    "@archally/semantic-checker": "github:archally/semantic-checker#v0.1.1",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
