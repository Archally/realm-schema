  "description": "YAML-based schema for private real estate modeling — dual-layer spatial topology, infrastructure systems, nature, maintenance operations, and surrounding context",
  "license": "Apache-2.0",
  "author": "Adam Walkowski <adam.walkowski@inperceptic.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/archally/realm-schema"
  },
  "homepage": "https://archally.pro",
  "keywords": [
    "realm",
    "real-estate",
    "property",
    "estate",
    "schema",
    "yaml",
    "json-schema",
    "spatial",
    "facility-management",
    "gdsm"
  ],
