# Normalize all text files to LF in the repository (schema repo consumed cross-OS)
* text=auto eol=lf

# Explicit text types
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf

# Binary assets (never normalize)
*.png  binary
*.jpg  binary
*.pdf  binary
